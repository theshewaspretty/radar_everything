# radar_everything environment example
# Copy to .env and edit. Do NOT commit real secrets.

APP_NAME=radar_everything

# Optional — without token GitHub API rate limit is lower (≈60 req/hr)
GITHUB_TOKEN=

# Optional — NVD API key improves CVE rate limits
NVD_API_KEY=

# Comma-separated collectors to enable
ENABLED_SOURCES=github,mcp,vulnerability

# Host port for docker compose
PORT=8080

# Collect immediately when container starts
COLLECT_ON_STARTUP=true

# UTC hours for scheduled collection
COLLECT_CRON_HOURS=6,18

DEFAULT_LIMIT=30
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
